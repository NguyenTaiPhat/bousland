{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BousLand",
  "version": "1.0.8",
  "identifier": "com.bousland.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BousLand",
        "label": "main",
        "width": 360,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NjkzRjVDODhFM0QyOEYKUldTUDB1T0lYRDlwV1hRemVENWgwTEJsQ2lHWUpsMG5saFh4TGVvVkE4YXJicDlNTE96a0hHQisK",
      "endpoints": [
        "https://github.com/NguyenTaiPhat/bousland/releases/latest/download/latest.json"
      ]
    }
  }
}
